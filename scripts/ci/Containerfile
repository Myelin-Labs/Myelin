# Prepare once with network access; run the core profile offline with explicit
# source/vendor inputs and an empty Cargo/target directory. No extra test driver.
FROM docker.io/library/rust@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2
RUN apt-get -o APT::Update::Error-Mode=any update && apt-get install -y --no-install-recommends \
    clang libclang-dev cmake protobuf-compiler python3 git pkg-config libssl-dev openssl bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add --toolchain 1.92.0 clippy rustfmt \
    && mkdir /inputs /work && chmod 1777 /work
